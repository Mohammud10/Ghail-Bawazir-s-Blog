generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH.JS (NextAuth v5) MODELS
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for local admin login
  role          Role      @default(ADMIN)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires      DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  EDITOR
}

// ============================================================
// CORE CONTENT MODELS (Bilingual using JSONB)
// ============================================================

model Category {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            Json         // e.g. { "en": "Health", "ar": "الصحة" }
  description     Json?        // e.g. { "en": "Health tools", "ar": "أدوات الصحة" }
  seoTitle        Json?
  seoDescription  Json?
  icon            String?
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  calculators     Calculator[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

model Calculator {
  id                 String     @id @default(cuid())
  slug               String     @unique
  categoryId         String
  category           Category   @relation(fields: [categoryId], references: [id])
  name               Json       // { "en": "...", "ar": "..." }
  description        Json?      // { "en": "...", "ar": "..." }
  content            Json?      // Rich text description / guide
  formulaExplanation Json?      // Law and formulas explanation
  example            Json?      // Practical example
  metaTitle          Json?
  metaDescription    Json?
  keywords           Json?      // { "en": ["bmi", "weight"], "ar": ["سمنة", "وزن"] }
  icon               String?
  sortOrder          Int        @default(0)
  isActive           Boolean    @default(true)
  isFeatured         Boolean    @default(false)
  calculatorType     String     // e.g. "bmi", "loan"
  faqs               FAQ[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([categoryId])
  @@index([sortOrder])
  @@index([isActive])
  @@index([isFeatured])
}

model FAQ {
  id           String      @id @default(cuid())
  calculatorId String?
  calculator   Calculator? @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  question     Json        // { "en": "...", "ar": "..." }
  answer       Json        // { "en": "...", "ar": "..." }
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([calculatorId])
  @@index([sortOrder])
  @@index([isActive])
}

// ============================================================
// ADVERTISING SYSTEM
// ============================================================

model AdSlot {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "header", "footer", "sidebar", etc.
  position  String
  adCode    String?  @db.Text
  format    String   @default("responsive")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ============================================================
// CONTACT & SUPPORT
// ============================================================

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// ============================================================
// SITE SETTINGS
// ============================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "siteName", "siteDescription", "adsenseEnabled"
  value     Json
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ============================================================
// ANALYTICS & LOGGING
// ============================================================

model SearchLog {
  id           String   @id @default(cuid())
  query        String
  locale       String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  pagePath  String
  locale    String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([pagePath])
  @@index([createdAt])
}
